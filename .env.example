# 한국투자증권(KIS) Open API 인증 정보
# - 앱 등록: https://apiportal.koreainvestment.com 에서 앱 발급 후 App Key / Secret 확인
# - 계좌번호: HTS/MTS의 8자리 계좌번호 (상품코드 제외), 상품코드는 보통 "01" (종합)
# - KIS_MODE: paper = 모의투자, real = 실전 (url + tr_id 자동 분기)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
KIS_ACCOUNT_PRODUCT_CODE=01
KIS_MODE=paper
