# =============================================================================
# 한국투자증권(KIS) Open API 인증 정보
# =============================================================================
#
# 라이브 자동매매·모의계좌 페이지를 사용할 때만 필요. 백테스트·자동 탐색만
# 쓸 거라면 이 파일을 비워둬도 동작합니다.
#
# 발급 절차:
#   - apps/engine/README.md §4.2 (자세한 4단계 가이드)
#   - 또는 https://apiportal.koreainvestment.com 에서 앱 등록
#   - 모의·실전은 별도 키 — 신청 시 "모의투자" / "실전투자" 종류 선택
#
# 계좌번호:
#   HTS/MTS 의 '12345678-01' 중 '-' 앞 8자리 → NUMBER, 뒤 2자리 → PRODUCT_CODE
#   상품코드는 일반적으로 01 (종합매매)
#
# ⚠️ 보안
#   - 이 파일(.env)은 .gitignore 됨. 커밋 금지.
#   - VPS·노트북 등에 옮길 때 권한 600 으로 (chmod 600 .env)
#   - APP_SECRET 노출 시 즉시 KIS 포털에서 재발급
#
# =============================================================================

# 모의투자 (paper) — 가상 자금. 시작점 권장.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NUMBER=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=01

# 실전투자 (real) — 실제 자금. paper 검증 충분 후에만 입력.
# 같은 키 / 계좌 절대 공유 금지 — 모의·실전은 별도 발급.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NUMBER=
KIS_REAL_ACCOUNT_PRODUCT_CODE=01

# 단일 mode CLI 호출 시 기본값 — `--mode` 없이 run_live.py 가 어느 mode 쓸지.
# 새 cron 흐름은 `run_live --mode all` 권장 (양쪽 활성 전략 모두 처리).
KIS_MODE=paper

# =============================================================================
# Slack 알림 (선택)
# =============================================================================
#
# live executor 사이클 결과·에러를 Slack 채널로 통보. 비워두면 알림 비활성.
#
# 발급:
#   1. https://api.slack.com/apps → Create New App → From scratch
#   2. Incoming Webhooks 활성화 → Add New Webhook to Workspace → 채널 선택
#   3. Webhook URL 복사
#
SLACK_WEBHOOK_URL=

# =============================================================================
# DART (전자공시) Open API
# =============================================================================
#
# 펀더멘털 factor (PBR, ROE, 부채비율 등) 계산용 분기 재무제표 수집에 사용.
# 백테스트만 쓸 거라도 팩터 포트폴리오 모드를 활성화하려면 필요.
#
# 발급:
#   https://opendart.fss.or.kr 에서 무료 가입 → 인증키 신청 → 즉시 발급
#
DART_API_KEY=
